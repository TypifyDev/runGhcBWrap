cabal-version: 3.4
name: runGhcBWrap
version: 0.1.0.0
build-type: Simple

library
  hs-source-dirs: src
  default-language: GHC2024
  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
  build-depends:
      base
    , text
    , which
    , transformers
    , directory
    , filepath
    , process
    , split
    , temporary
    , runGhcBWrap-core
  exposed-modules:
        RunGhcBWrap

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: GHC2024
  default-extensions:
    FunctionalDependencies
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    RecursiveDo
    TemplateHaskell
    TypeFamilies
  build-depends:
      base
    , runGhcBWrap
    , runGhcBWrap-core
    , tasty
    , tasty-hunit
    , text
    , transformers
